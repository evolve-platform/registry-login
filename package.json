{
  "name": "registry-login",
  "version": "1.0.0",
  "description": "Exchange a GitHub Actions OIDC token for an evolve-registry token and write it to .npmrc",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.1",
  "files": [
    "dist",
    "action.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "package": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
