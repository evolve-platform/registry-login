{
  "name": "registry-login",
  "version": "1.0.0",
  "description": "Exchange a GitHub Actions OIDC token for an evolve-registry token and write it to .npmrc",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "build": "tsdown",
    "package": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "dependencies": {
    "@actions/core": "^1.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.0.0",
    "tsdown": "^0.9.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
